{
  "name": "notes",
  "version": "0.1.0",
  "description": "Render a folder of Markdown notes as a local site with search, diagrams and source links",
  "private": true,
  "type": "module",
  "bin": {
    "notes": "bin/notes.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "public",
    "astro.config.mjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm test && NOTES_OUT=tests/fixture/.notes ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "cd tests/fixture && node --test ../unit/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "test:fixture": "node tests/integration/fixture-note.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/starlight": "0.41.10",
    "@mermaid-js/layout-elk": "0.2.3",
    "astro": "7.2.9",
    "astro-mermaid": "2.1.0",
    "esbuild": "0.28.2",
    "mdast-util-from-markdown": "2.0.3",
    "mermaid": "11.17.2",
    "pagefind": "1.5.2",
    "remark-breaks": "4.0.0",
    "shiki": "4.4.3",
    "starlight-fullview-mode": "0.2.6",
    "typescript": "6.0.3",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "chokidar": "^4.0.3",
    "playwright-core": "^1.62.1"
  }
}
