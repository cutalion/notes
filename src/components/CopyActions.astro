---
const { entry } = Astro.locals.starlightRoute;
// `fillShell()` in `scripts/shell.mjs` replaces both markers with the paths of the note, and
// removes the whole block from a page that has no Markdown file behind it.
const isNote = entry.id === 'notespathmarker';
const rawUrl = '/notesrawurlmarker';
const projectPath = 'notesprojectpathmarker';
---

{isNote && (
  <div
    class="notes-copy-actions"
    data-note-actions
    data-note-raw-url={rawUrl}
    data-note-project-path={projectPath}
  >
    <div class="notes-copy-control">
      <button class="notes-copy-primary" type="button" data-note-copy="markdown">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <rect width="13" height="13" x="8" y="8" rx="2"></rect>
          <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
        </svg>
        <span data-note-copy-label>Copy page</span>
      </button>
      <details class="notes-copy-dropdown">
        <summary aria-label="Show copy options" title="Show copy options">
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m7 10 5 5 5-5"></path></svg>
        </summary>
        <div class="notes-copy-menu">
          <button type="button" data-note-copy="markdown">
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <rect width="13" height="13" x="8" y="8" rx="2"></rect>
              <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
            </svg>
            <span>
              <strong>Copy Markdown</strong>
              <small>Copy note content as text</small>
            </span>
          </button>
          <button type="button" data-note-copy="path" title={projectPath}>
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
              <path d="M14 2v6h6M8 13h8M8 17h8"></path>
            </svg>
            <span>
              <strong>Copy file path</strong>
              <small>{projectPath}</small>
            </span>
          </button>
          <a href={rawUrl}>
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
              <path d="M14 2v6h6M9 18v-5l2 2 2-2v5"></path>
            </svg>
            <span>
              <strong>Open Markdown</strong>
              <small>{rawUrl}</small>
            </span>
          </a>
        </div>
      </details>
    </div>
    <span class="notes-copy-status" data-note-copy-status aria-live="polite"></span>
  </div>
)}

<script>
  async function copyText(value: string) {
    if (!navigator.clipboard?.writeText) throw new Error('Clipboard access is unavailable');
    await navigator.clipboard.writeText(value);
  }

  for (const actions of document.querySelectorAll<HTMLElement>('[data-note-actions]')) {
    const rawUrl = actions.dataset.noteRawUrl;
    const projectPath = actions.dataset.noteProjectPath;
    const dropdown = actions.querySelector<HTMLDetailsElement>('.notes-copy-dropdown');
    const mainLabel = actions.querySelector<HTMLElement>('[data-note-copy-label]');
    const status = actions.querySelector<HTMLElement>('[data-note-copy-status]');
    const buttons = [...actions.querySelectorAll<HTMLButtonElement>('[data-note-copy]')];
    let resetTimer: number | undefined;

    const report = (message: string, label: string) => {
      if (status) status.textContent = message;
      if (mainLabel) mainLabel.textContent = label;
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        if (mainLabel) mainLabel.textContent = 'Copy page';
        if (status) status.textContent = '';
      }, 1800);
    };

    for (const button of buttons) {
      button.addEventListener('click', async () => {
        try {
          for (const candidate of buttons) candidate.disabled = true;
          if (button.dataset.noteCopy === 'path') {
            if (!projectPath) throw new Error('Note path is unavailable');
            await copyText(projectPath);
            report('Copied note file path.', 'Copied path');
          } else {
            if (!rawUrl) throw new Error('Raw note URL is unavailable');
            const response = await fetch(rawUrl, { cache: 'no-store', headers: { Accept: 'text/plain' } });
            if (!response.ok) throw new Error(`Raw note request failed with ${response.status}`);
            await copyText(await response.text());
            report('Copied note content as Markdown.', 'Copied Markdown');
          }
          dropdown?.removeAttribute('open');
        } catch (error) {
          console.error(error);
          report('Could not copy. Check browser clipboard permissions.', 'Copy failed');
        } finally {
          for (const candidate of buttons) candidate.disabled = false;
        }
      });
    }

    document.addEventListener('click', (event) => {
      if (!actions.contains(event.target as Node)) dropdown?.removeAttribute('open');
    });
    dropdown?.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      dropdown.removeAttribute('open');
      dropdown.querySelector('summary')?.focus();
    });
  }
</script>

<style>
  .notes-copy-actions {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    align-items: center;
  }

  .notes-copy-control {
    display: flex;
    border: 1px solid var(--notes-color-line);
    border-radius: var(--notes-radius-small);
  }

  .notes-copy-dropdown {
    display: flex;
  }

  .notes-copy-primary,
  .notes-copy-dropdown summary {
    display: inline-flex;
    height: calc(var(--notes-control-height) - 2px);
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--notes-color-body);
    cursor: pointer;
    font: 500 var(--notes-text-control) / 1 var(--__sl-font);
  }

  .notes-copy-primary {
    gap: var(--notes-space-1);
    padding-inline: var(--notes-space-2) calc(var(--notes-space-1) * 1.5);
    border-radius: calc(var(--notes-radius-small) - 1px) 0 0 calc(var(--notes-radius-small) - 1px);
  }

  .notes-copy-dropdown summary {
    width: calc(var(--notes-control-height) - 2px);
    border-inline-start: 1px solid var(--notes-color-line);
    border-radius: 0 calc(var(--notes-radius-small) - 1px) calc(var(--notes-radius-small) - 1px) 0;
    list-style: none;
  }

  .notes-copy-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .notes-copy-primary:hover,
  .notes-copy-dropdown summary:hover {
    background: var(--notes-color-hover);
  }

  .notes-copy-dropdown[open] summary {
    background: var(--notes-color-pressed);
  }

  .notes-copy-primary:disabled,
  .notes-copy-menu button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  svg {
    width: var(--notes-icon-size);
    height: var(--notes-icon-size);
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: var(--notes-icon-stroke);
  }

  .notes-copy-menu {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(100% + var(--notes-space-1));
    inset-inline-end: 0;
    display: flex;
    flex-direction: column;
    width: min(var(--notes-menu-width), calc(100vw - 2 * var(--sl-content-pad-x)));
    padding: var(--notes-space-1);
    border: 1px solid var(--notes-color-line);
    border-radius: var(--notes-radius-large);
    background: var(--notes-color-layer);
    box-shadow: var(--notes-shadow-layer);
    animation: notes-layer-in 0.12s ease-out;
  }

  .notes-copy-menu button,
  .notes-copy-menu a {
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: var(--notes-space-2);
    padding: var(--notes-space-1) var(--notes-space-2);
    border: 0;
    border-radius: var(--notes-radius-small);
    background: transparent;
    color: var(--notes-color-muted);
    cursor: pointer;
    text-align: start;
    text-decoration: none;
  }

  .notes-copy-menu button:hover,
  .notes-copy-menu a:hover {
    background: var(--notes-color-hover);
  }

  /* The icon hangs to the left of the two text lines and centers on the first of them. */
  .notes-copy-menu :is(button, a) > svg {
    margin-block-start: calc((var(--notes-text-nav) * 1.4 - var(--notes-icon-size)) / 2);
  }

  .notes-copy-menu :is(button, a) > span {
    min-width: 0;
  }

  .notes-copy-menu strong,
  .notes-copy-menu small {
    display: block;
  }

  .notes-copy-menu strong {
    color: var(--notes-color-ink);
    font-size: var(--notes-text-nav);
    font-weight: 600;
    line-height: 1.4;
  }

  .notes-copy-menu small {
    overflow-wrap: anywhere;
    color: var(--notes-color-muted);
    font-size: var(--notes-text-control);
    line-height: 1.4;
  }

  /* Only the two paths are set in the monospaced face. The description is ordinary words. */
  .notes-copy-menu :is([data-note-copy='path'], a) small {
    font-family: var(--__sl-font-mono);
  }

  .notes-copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* A narrow header keeps the icon and drops the words. The menu takes the width of the screen. */
  @media (max-width: 50rem) {
    .notes-copy-primary {
      width: calc(var(--notes-control-height) - 2px);
      padding-inline: 0;
    }

    .notes-copy-primary [data-note-copy-label] {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .notes-copy-menu {
      position: fixed;
      inset-block-start: var(--sl-nav-height);
      inset-inline: var(--notes-space-1);
      width: auto;
    }
  }
</style>
