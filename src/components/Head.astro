---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default {...Astro.props}><slot /></Default>

{/* Inline, so the stored panels are in place before the first paint. */}
<script is:inline>
  (() => {
    const root = document.documentElement;
    const stored = (key) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    if (stored('notes:mainSideBarCollapsed') === 'true') root.dataset.notesTree = 'unpinned';
    if (stored('notes:rightSideBarCollapsed') === 'true') root.dataset.notesToc = 'hidden';
    const column = stored('notes:columnWidth');
    if (column === 'wide' || column === 'full') root.dataset.notesWidth = column;
    const widths = [
      ['notes:leftSidebarWidth', '--notes-tree-width', 192, 576],
      ['notes:rightSidebarWidth', '--notes-toc-width', 176, 512],
    ];
    for (const [key, property, min, max] of widths) {
      const width = Number(stored(key));
      if (width >= min && width <= max) root.style.setProperty(property, `${width}px`);
    }
  })();
</script>

<script>
  const sidebarWidths = {
    left: {
      storageKey: 'notes:leftSidebarWidth',
      cssProperty: '--notes-tree-width',
      min: 192,
      max: 576,
    },
    right: {
      storageKey: 'notes:rightSidebarWidth',
      cssProperty: '--notes-toc-width',
      min: 176,
      max: 512,
    },
  } as const;

  function installSidebarSorting() {
    const select = document.querySelector<HTMLSelectElement>('#notes-sidebar-sort');
    const list = document.querySelector<HTMLUListElement>('#starlight__sidebar ul.top-level');
    if (!select || !list) return;
    const sidebarList = list;

    const modes = ['recent-desc', 'recent-asc', 'title-asc', 'title-desc'] as const;
    type SortMode = typeof modes[number];
    const validModes = new Set<SortMode>(modes);
    const persistedMode = localStorage.getItem('notes:sidebarSort') as SortMode | null;
    const collator = new Intl.Collator('en', { numeric: true, sensitivity: 'base' });

    function detailsFor(item: HTMLLIElement) {
      const details = item.firstElementChild;
      return details instanceof HTMLDetailsElement ? details : undefined;
    }

    function noteTitle(item: HTMLLIElement) {
      return item.querySelector<HTMLAnchorElement>('a[data-note-title]')?.dataset.noteTitle ?? '';
    }

    function noteUpdated(item: HTMLLIElement) {
      return Number(item.querySelector<HTMLAnchorElement>('a[data-note-updated]')?.dataset.noteUpdated) || 0;
    }

    function groupTitle(item: HTMLLIElement) {
      return detailsFor(item)?.querySelector<HTMLElement>('.group-label')?.textContent?.trim() ?? '';
    }

    function groupUpdated(item: HTMLLIElement) {
      const updates = [...item.querySelectorAll<HTMLAnchorElement>('a[data-note-updated]')]
        .map((link) => Number(link.dataset.noteUpdated) || 0);
      return Math.max(0, ...updates);
    }

    function sortSidebar(mode: SortMode) {
      const direction = mode.endsWith('desc') ? -1 : 1;
      const byTitle = mode.startsWith('title');
      const topItems = [...sidebarList.children].filter((item): item is HTMLLIElement => item instanceof HTMLLIElement);
      const fixedItems = topItems.filter((item) => !detailsFor(item));
      const groupItems = topItems.filter((item) => detailsFor(item));

      for (const groupItem of groupItems) {
        const groupList = detailsFor(groupItem)?.querySelector<HTMLUListElement>('ul');
        if (!groupList) continue;
        const noteItems = [...groupList.children].filter((item): item is HTMLLIElement => item instanceof HTMLLIElement);
        noteItems.sort((a, b) => {
          const primary = byTitle
            ? collator.compare(noteTitle(a), noteTitle(b))
            : noteUpdated(a) - noteUpdated(b);
          return (primary * direction) || collator.compare(noteTitle(a), noteTitle(b));
        });
        groupList.append(...noteItems);
      }

      groupItems.sort((a, b) => {
        const primary = byTitle
          ? collator.compare(groupTitle(a), groupTitle(b))
          : groupUpdated(a) - groupUpdated(b);
        return (primary * direction) || collator.compare(groupTitle(a), groupTitle(b));
      });
      sidebarList.append(...fixedItems, ...groupItems);
    }

    const initialMode = persistedMode && validModes.has(persistedMode) ? persistedMode : 'recent-desc';
    select.value = initialMode;
    sortSidebar(initialMode);
    select.addEventListener('change', () => {
      const mode = select.value as SortMode;
      if (!validModes.has(mode)) return;
      sortSidebar(mode);
      localStorage.setItem('notes:sidebarSort', mode);
    });
  }

  // A long name is cut in the tree, so the whole name goes into the tooltip.
  function installTreeTooltips() {
    for (const row of document.querySelectorAll<HTMLElement>('#starlight__sidebar :is(a, summary)')) {
      row.title = row.textContent?.trim() ?? '';
    }
  }

  function installSidebarResizers() {
    const sides = [
      { side: 'left', container: document.querySelector<HTMLElement>('.sidebar-pane') },
      { side: 'right', container: document.querySelector<HTMLElement>('.right-sidebar-container') },
    ] as const;

    for (const { side, container } of sides) {
      if (!container || document.querySelector(`[data-notes-resizer="${side}"]`)) continue;
      const settings = sidebarWidths[side];
      const handle = document.createElement('div');
      handle.className = 'notes-sidebar-resizer';
      handle.dataset.notesResizer = side;
      handle.setAttribute('role', 'separator');
      handle.setAttribute('aria-orientation', 'vertical');
      handle.setAttribute('aria-label', `Resize ${side} sidebar`);
      handle.setAttribute('aria-valuemin', String(settings.min));
      handle.setAttribute('aria-valuemax', String(settings.max));
      handle.tabIndex = 0;
      document.body.append(handle);

      const viewportMaximum = () => Math.min(settings.max, window.innerWidth * (side === 'left' ? 0.45 : 0.4));
      const currentWidth = () => container.getBoundingClientRect().width;
      const setWidth = (value: number, persist = false) => {
        const width = Math.round(Math.min(viewportMaximum(), Math.max(settings.min, value)));
        document.documentElement.style.setProperty(settings.cssProperty, `${width}px`);
        handle.setAttribute('aria-valuenow', String(width));
        if (persist) localStorage.setItem(settings.storageKey, String(width));
      };
      const widthFromPointer = (event: PointerEvent) => (
        side === 'left' ? event.clientX : window.innerWidth - event.clientX
      );
      const stopResizing = (event: PointerEvent) => {
        if (!handle.hasPointerCapture(event.pointerId)) return;
        handle.releasePointerCapture(event.pointerId);
        document.body.classList.remove('notes-sidebar-resizing');
        setWidth(currentWidth(), true);
      };

      handle.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        event.preventDefault();
        handle.setPointerCapture(event.pointerId);
        document.body.classList.add('notes-sidebar-resizing');
        setWidth(widthFromPointer(event));
      });
      handle.addEventListener('pointermove', (event) => {
        if (!handle.hasPointerCapture(event.pointerId)) return;
        setWidth(widthFromPointer(event));
      });
      handle.addEventListener('pointerup', stopResizing);
      handle.addEventListener('pointercancel', stopResizing);
      handle.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const sideDirection = side === 'left' ? direction : -direction;
        setWidth(currentWidth() + (sideDirection * 16), true);
      });
      const configuredWidth = Number.parseFloat(
        getComputedStyle(document.documentElement).getPropertyValue(settings.cssProperty),
      );
      handle.setAttribute('aria-valuenow', String(Math.round(configuredWidth)));
    }
  }

  function readableMermaidColor(fill: string) {
    const channels = fill.match(/[\d.]+/g)?.slice(0, 3).map(Number);
    if (!channels || channels.length !== 3) return;
    const linear = channels.map((channel) => {
      const value = channel / 255;
      return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
    });
    const luminance = (0.2126 * linear[0]!) + (0.7152 * linear[1]!) + (0.0722 * linear[2]!);
    const blackContrast = (luminance + 0.05) / 0.05;
    const whiteContrast = 1.05 / (luminance + 0.05);
    return blackContrast >= whiteContrast ? '#111827' : '#f8fafc';
  }

  function normalizeMermaidContrast(diagram: HTMLElement) {
    for (const node of diagram.querySelectorAll<SVGGElement>('.node')) {
      const shape = node.querySelector<SVGElement>('rect, polygon, circle, ellipse, path');
      if (!shape) continue;
      const foreground = readableMermaidColor(getComputedStyle(shape).fill);
      if (!foreground) continue;
      node.style.setProperty('color', foreground, 'important');
      for (const label of node.querySelectorAll<HTMLElement | SVGElement>('.nodeLabel, .label, foreignObject *, text, tspan')) {
        label.style.setProperty('color', foreground, 'important');
        label.style.setProperty('fill', foreground, 'important');
      }
    }
  }

  // The button says that the text is on the clipboard, and falls back to its rest state.
  const copyTimers = new WeakMap<HTMLElement, number>();
  async function copyText(button: HTMLElement, text: string) {
    try {
      await navigator.clipboard.writeText(text);
      button.dataset.copied = '';
      window.clearTimeout(copyTimers.get(button));
      copyTimers.set(button, window.setTimeout(() => delete button.dataset.copied, 1500));
    } catch (error) {
      console.error(error);
    }
  }

  // Folded diagrams persist for their note, as folded sections do. A diagram is known by its
  // source, so it stays folded when the note around it changes, and opens when it changes itself.
  const foldedDiagramsKey = `notes:foldedDiagrams:${location.pathname}`;
  function foldedDiagrams() {
    try {
      return new Set<string>(JSON.parse(localStorage.getItem(foldedDiagramsKey) ?? '[]'));
    } catch {
      return new Set<string>();
    }
  }

  function rememberDiagramFold(key: string, folded: boolean) {
    const all = foldedDiagrams();
    if (folded) all.add(key);
    else all.delete(key);
    if (all.size) localStorage.setItem(foldedDiagramsKey, JSON.stringify([...all]));
    else localStorage.removeItem(foldedDiagramsKey);
  }

  function diagramKey(source: string) {
    let hash = 5381;
    for (let index = 0; index < source.length; index += 1) hash = ((hash * 33) ^ source.charCodeAt(index)) >>> 0;
    return hash.toString(36);
  }

  function wrapMermaidDiagram(diagram: HTMLElement) {
    normalizeMermaidContrast(diagram);
    if (diagram.closest('.mermaid-viewport')) return;

    // The block is a frame with its own thin header: the caption on the left, the tools on the right.
    const block = document.createElement('div');
    block.className = 'mermaid-block';
    const header = document.createElement('div');
    header.className = 'mermaid-header';
    const icon = (paths: string) => `<svg aria-hidden="true" viewBox="0 0 24 24">${paths}</svg>`;
    // The caption is the fold button: the whole title is the target, not only the mark before it.
    const foldButton = document.createElement('button');
    foldButton.type = 'button';
    foldButton.className = 'mermaid-fold';
    foldButton.title = 'Fold or unfold the diagram';
    foldButton.innerHTML = icon('<path d="m6 9 6 6 6-6"/>');
    const caption = document.createElement('span');
    caption.className = 'mermaid-caption';
    // The build moves the title of a diagram from its source into this attribute.
    caption.textContent = diagram.dataset.notesTitle || 'Diagram';
    foldButton.append(caption);
    // The source as the author wrote it, with the title that the build took out of it.
    const source = diagram.dataset.notesSource ?? diagram.dataset.diagram ?? '';
    const key = diagramKey(source);
    const viewport = document.createElement('div');
    viewport.className = 'mermaid-viewport';
    const pane = document.createElement('div');
    pane.className = 'mermaid-pane';
    const toolbar = document.createElement('div');
    toolbar.className = 'mermaid-tools';
    toolbar.setAttribute('role', 'group');
    toolbar.setAttribute('aria-label', 'Diagram controls');

    const controls = [
      ['copy', icon('<rect width="13" height="13" x="8" y="8" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>'), 'Copy the source of the diagram'],
      ['out', icon('<path d="M5 12h14"/>'), 'Zoom out'],
      ['in', icon('<path d="M5 12h14M12 5v14"/>'), 'Zoom in'],
      ['reset', '1:1', 'Reset pan and zoom'],
      ['fullscreen', icon('<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>'), 'Toggle full screen'],
    ];
    for (const [action, content, label] of controls) {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.mermaidAction = action;
      button.innerHTML = content;
      button.title = label;
      button.setAttribute('aria-label', label);
      toolbar.append(button);
    }

    diagram.replaceWith(block);
    pane.append(diagram);
    viewport.append(pane);
    header.append(foldButton, toolbar);
    block.append(header, viewport);

    let scale = 1;
    let offsetX = 0;
    let offsetY = 0;
    let fitScale = 1;
    let fitX = 0;
    let dragOrigin: { x: number; y: number } | undefined;

    const draw = () => {
      pane.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
      viewport.classList.toggle('is-zoomed', scale !== fitScale || offsetX !== fitX || offsetY !== 0);
    };
    // Shrink a tall diagram so the whole picture fits in 80% of the window height.
    const fit = () => {
      const svg = diagram.querySelector('svg');
      // A folded diagram has no size. It is measured when it unfolds.
      if (!svg || block.hasAttribute('data-notes-collapsed')) return;
      const isFullscreen = document.fullscreenElement === block;
      // Measure at the natural size, with the transform transition off so the old transform does not leak in.
      pane.style.transition = 'none';
      pane.style.transform = '';
      viewport.style.height = '';
      // Mermaid shrinks a picture to the width it gets. A picture that is wider than the column
      // at its natural size takes the margins of the column first, and shrinks only after that.
      // A few pixels are not worth a step out of the column.
      delete block.dataset.wide;
      const frame = getComputedStyle(diagram);
      const around = block.offsetWidth - viewport.clientWidth
        + parseFloat(frame.paddingLeft) + parseFloat(frame.paddingRight);
      // A tall picture is shrunk to the height limit below, and needs only the width it has then.
      const box = svg.viewBox.baseVal;
      const tall = parseFloat(frame.paddingTop) + parseFloat(frame.paddingBottom) + box.height;
      const natural = Math.ceil(box.width * Math.min(1, window.innerHeight * 0.8 / tall) + around);
      if (!isFullscreen && block.parentElement?.matches('.sl-markdown-content') && natural > block.offsetWidth + 8) {
        block.style.setProperty('--notes-natural-width', `${natural}px`);
        block.dataset.wide = '';
      }
      const rect = svg.getBoundingClientRect();
      // The SVG may already sit centered inside the pane; translate relative to that position.
      const svgLeft = rect.left - pane.getBoundingClientRect().left;
      const maxHeight = isFullscreen ? viewport.clientHeight : window.innerHeight * 0.8;
      // In the note the pane also holds the padding around the picture, and all of it must fit.
      const height = isFullscreen ? rect.height : pane.getBoundingClientRect().height;
      fitScale = Math.min(1, maxHeight / height, viewport.clientWidth / rect.width);
      if (!isFullscreen && fitScale < 1) viewport.style.height = `${Math.ceil(height * fitScale)}px`;
      fitX = (viewport.clientWidth - rect.width * fitScale) / 2 - svgLeft * fitScale;
      scale = fitScale;
      offsetX = fitX;
      offsetY = 0;
      draw();
      pane.style.transition = '';
    };
    const reset = () => fit();
    const zoomAt = (nextScale: number, x: number, y: number) => {
      const bounded = Math.min(8, Math.max(0.4, nextScale));
      offsetX = x - ((x - offsetX) * bounded / scale);
      offsetY = y - ((y - offsetY) * bounded / scale);
      scale = bounded;
      draw();
    };
    const localPoint = (event: MouseEvent | WheelEvent) => {
      const bounds = viewport.getBoundingClientRect();
      return [
        event.clientX - bounds.left - pane.offsetLeft,
        event.clientY - bounds.top - pane.offsetTop,
      ] as const;
    };

    viewport.addEventListener('wheel', (event) => {
      const isFullscreen = document.fullscreenElement === block;
      if (!isFullscreen && !event.ctrlKey && !event.metaKey) return;
      event.preventDefault();
      zoomAt(scale * Math.exp(-event.deltaY / 300), ...localPoint(event));
    }, { passive: false });
    viewport.addEventListener('dblclick', (event) => {
            zoomAt(scale >= 2 ? 1 : scale * 2, ...localPoint(event));
    });
    viewport.addEventListener('pointerdown', (event) => {
      if (!viewport.classList.contains('is-zoomed')) return;
      event.preventDefault();
      window.getSelection()?.removeAllRanges();
      const rendered = new DOMMatrixReadOnly(getComputedStyle(pane).transform);
      scale = rendered.a;
      offsetX = rendered.e;
      offsetY = rendered.f;
      pane.style.transform = `translate(${offsetX}px, ${offsetY}px) scale(${scale})`;
      dragOrigin = { x: event.clientX - offsetX, y: event.clientY - offsetY };
      viewport.setPointerCapture(event.pointerId);
      viewport.classList.add('is-dragging');
    });
    viewport.addEventListener('pointermove', (event) => {
      if (!dragOrigin) return;
      offsetX = event.clientX - dragOrigin.x;
      offsetY = event.clientY - dragOrigin.y;
      draw();
    });
    const stopDragging = () => {
      dragOrigin = undefined;
      viewport.classList.remove('is-dragging');
    };
    viewport.addEventListener('pointerup', stopDragging);
    viewport.addEventListener('pointercancel', stopDragging);
    toolbar.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-mermaid-action]');
      if (!button) return;
      // The source goes to the clipboard in its code fence, ready for another note or a chat.
      if (button.dataset.mermaidAction === 'copy') copyText(button, `\`\`\`mermaid\n${source}\n\`\`\``);
      const centerX = pane.clientWidth / 2;
      const centerY = pane.clientHeight / 2;
      if (button.dataset.mermaidAction === 'in') zoomAt(scale * 1.4, centerX, centerY);
      if (button.dataset.mermaidAction === 'out') zoomAt(scale / 1.4, centerX, centerY);
      if (button.dataset.mermaidAction === 'reset') reset();
      if (button.dataset.mermaidAction === 'fullscreen') {
        if (document.fullscreenElement) document.exitFullscreen();
        else block.requestFullscreen().catch(() => undefined);
      }
    });
    const setFolded = (folded: boolean) => {
      block.toggleAttribute('data-notes-collapsed', folded);
      foldButton.setAttribute('aria-expanded', String(!folded));
      // A header alone has no reason to stand in the margins.
      if (folded) delete block.dataset.wide;
      else fit();
    };
    foldButton.addEventListener('click', () => {
      const folded = !block.hasAttribute('data-notes-collapsed');
      setFolded(folded);
      rememberDiagramFold(key, folded);
    });
    setFolded(foldedDiagrams().has(key));
    block.addEventListener('fullscreenchange', fit);
    window.addEventListener('resize', () => {
      if (!viewport.classList.contains('is-zoomed')) fit();
    });
  }

  // Mermaid and its ELK layout come from the server as their packages ship them. A path in a
  // variable keeps the bundler away from them: the shell build must not bundle the library.
  const mermaidModule = '/_mermaid/mermaid.esm.min.mjs';
  const elkModule = '/_mermaid-layout-elk/mermaid-layout-elk.esm.min.mjs';
  let mermaidLoading: Promise<any> | undefined;

  function loadMermaid() {
    mermaidLoading ??= Promise.all([
      import(/* @vite-ignore */ mermaidModule),
      import(/* @vite-ignore */ elkModule),
    ]).then(([{ default: mermaid }, { default: elkLayouts }]) => {
      // Left on, Mermaid draws every diagram itself when the page has loaded, with its default config.
      mermaid.startOnLoad = false;
      mermaid.registerLayoutLoaders(elkLayouts);
      return mermaid;
    });
    return mermaidLoading;
  }

  async function drawDiagrams() {
    const diagrams = [...document.querySelectorAll<HTMLElement>('pre.mermaid:not([data-processed])')];
    if (!diagrams.length) return;
    const mermaid = await loadMermaid();
    mermaid.initialize({
      startOnLoad: false,
      theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default',
      securityLevel: 'strict',
      layout: 'elk',
      flowchart: { defaultRenderer: 'elk' },
      state: { defaultRenderer: 'elk' },
      elk: { considerModelOrder: 'NONE', mergeEdges: false },
    });
    for (const diagram of diagrams) {
      // The source is kept, because a change of the theme draws the diagram again.
      diagram.dataset.diagram ??= diagram.textContent ?? '';
      const id = `mermaid-${Math.random().toString(36).slice(2, 11)}`;
      delete diagram.dataset.notesError;
      try {
        diagram.innerHTML = (await mermaid.render(id, diagram.dataset.diagram)).svg;
      } catch (error) {
        console.error(error);
        diagram.textContent = `Error rendering diagram: ${error instanceof Error ? error.message : error}`;
        diagram.dataset.notesError = '';
        // Mermaid draws in a block at the end of the page, and leaves it there when the source is wrong.
        document.getElementById(`d${id}`)?.remove();
      }
      // The tools below wait for this attribute.
      diagram.dataset.processed = 'true';
    }
  }

  // Mermaid only loads on a page with a diagram. A diagram takes the colours of the theme when it
  // is drawn, so a change of the theme draws all of them again, one pass after another.
  function installDiagrams() {
    let drawing = Promise.resolve();
    const draw = () => {
      drawing = drawing.then(drawDiagrams).catch((error) => console.error(error));
    };
    draw();
    new MutationObserver(() => {
      for (const diagram of document.querySelectorAll('pre.mermaid[data-processed]')) {
        diagram.removeAttribute('data-processed');
      }
      draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }

  function installMermaidTools() {
    const prepare = () => {
      for (const diagram of document.querySelectorAll<HTMLElement>('pre.mermaid[data-processed]')) {
        if (diagram.querySelector('svg')) wrapMermaidDiagram(diagram);
      }
    };
    prepare();
    const observer = new MutationObserver(prepare);
    observer.observe(document.body, {
      subtree: true,
      childList: true,
      attributes: true,
      attributeFilter: ['data-processed'],
    });
  }

  // A table that cannot fit in the column even with every cell wrapped grows into the margins
  // of the column. If the margins are not enough either, it scrolls inside itself.
  function installWideTables() {
    const pane = document.querySelector('.main-pane');
    const tables = [...document.querySelectorAll<HTMLElement>('.sl-markdown-content > table')];
    if (!pane || !tables.length) return;
    const overflows = (table: HTMLElement) => table.scrollWidth > table.clientWidth;
    const measure = () => {
      for (const table of tables) {
        delete table.dataset.wide;
        delete table.dataset.scroll;
        table.removeAttribute('tabindex');
        if (!overflows(table)) continue;
        table.dataset.wide = '';
        if (!overflows(table)) continue;
        table.dataset.scroll = '';
        // A scrolling block must be reachable from the keyboard.
        table.tabIndex = 0;
      }
    };
    new ResizeObserver(measure).observe(pane);
    // Unfolding a section sends this event: a table that was hidden measures itself now.
    window.addEventListener('resize', measure);
  }

  // Every heading gets a mark that folds its section: all that stands below the heading, up to
  // the next heading of the same or a higher level. The note is a flat list of blocks, so a block
  // is hidden when any heading above it in the outline is folded.
  function installSectionFolding() {
    const content = document.querySelector<HTMLElement>('.sl-markdown-content');
    if (!content) return;
    const level = (element: Element) => Number(element.className.match(/level-h(\d)/)?.[1] ?? 0);
    const wrappers = [...content.children].filter((child): child is HTMLElement => (
      child.classList.contains('sl-heading-wrapper') && Boolean(child.querySelector('[id]'))
    ));
    if (!wrappers.length) return;
    const id = (wrapper: HTMLElement) => wrapper.querySelector('[id]')!.id;
    const storageKey = `notes:foldedSections:${location.pathname}`;
    let stored: string[] = [];
    try {
      stored = JSON.parse(localStorage.getItem(storageKey) ?? '[]');
    } catch {
      stored = [];
    }
    const folded = new Set(wrappers.filter((wrapper) => stored.includes(id(wrapper))));

    const draw = () => {
      // The folded headings above the current block, the outermost first.
      const outline: HTMLElement[] = [];
      for (const child of content.children) {
        const isHeading = wrappers.includes(child as HTMLElement);
        if (isHeading) {
          while (outline.length && level(outline[outline.length - 1]) >= level(child)) outline.pop();
        }
        child.toggleAttribute('data-notes-folded', outline.some((wrapper) => folded.has(wrapper)));
        if (isHeading) outline.push(child as HTMLElement);
      }
      for (const wrapper of wrappers) {
        wrapper.toggleAttribute('data-notes-section-folded', folded.has(wrapper));
        wrapper.querySelector('.notes-fold')?.setAttribute('aria-expanded', String(!folded.has(wrapper)));
      }
      if (folded.size) localStorage.setItem(storageKey, JSON.stringify([...folded].map(id)));
      else localStorage.removeItem(storageKey);
      // A diagram or a table that was hidden has not measured itself yet.
      window.dispatchEvent(new Event('resize'));
    };

    // A link to a place inside a folded section opens every section around that place.
    const reveal = (hash: string) => {
      let target: Element | null = null;
      try {
        target = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
      } catch {
        return;
      }
      while (target && target.parentElement !== content) target = target.parentElement;
      if (!target) return;
      let limit = wrappers.includes(target as HTMLElement) ? level(target) : 7;
      let opened = false;
      for (let block = target.previousElementSibling; block; block = block.previousElementSibling) {
        if (!wrappers.includes(block as HTMLElement) || level(block) >= limit) continue;
        limit = level(block);
        opened = folded.delete(block as HTMLElement) || opened;
      }
      if (!opened) return;
      draw();
      document.getElementById(decodeURIComponent(hash.slice(1)))?.scrollIntoView();
    };

    for (const wrapper of wrappers) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'notes-fold';
      button.title = 'Fold or unfold the section. With Alt, all sections of this level';
      button.setAttribute('aria-label', `Section: ${wrapper.querySelector('[id]')!.textContent}`);
      button.innerHTML = '<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>';
      button.addEventListener('click', (event) => {
        const fold = !folded.has(wrapper);
        const targets = event.altKey ? wrappers.filter((other) => level(other) === level(wrapper)) : [wrapper];
        for (const target of targets) {
          if (fold) folded.add(target);
          else folded.delete(target);
        }
        // The heading stays where it is on the screen, whatever folds above it.
        const top = wrapper.getBoundingClientRect().top;
        draw();
        window.scrollBy(0, wrapper.getBoundingClientRect().top - top);
      });
      // The heading must stay the first child: Starlight styles it by that.
      wrapper.append(button);
    }

    draw();
    reveal(location.hash);
    window.addEventListener('hashchange', () => reveal(location.hash));
    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      if (link) reveal(link.hash);
    });
  }

  function installCodeCopy() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('.notes-code-copy')) {
      button.addEventListener('click', () => {
        copyText(button, button.parentElement?.querySelector('pre')?.textContent ?? '');
      });
    }
  }

  // Starlight opens the search on the letter `k`. Another keyboard layout gives the same key
  // another letter, so repeat the shortcut for it by the position of the key.
  window.addEventListener('keydown', (event) => {
    const isShortcut = (event.ctrlKey || event.metaKey) && !event.shiftKey && !event.altKey;
    if (!isShortcut || event.code !== 'KeyK' || event.key === 'k') return;
    event.preventDefault();
    window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', code: 'KeyK', ctrlKey: true }));
  });

  document.addEventListener('DOMContentLoaded', () => {
    installSidebarSorting();
    installTreeTooltips();
    installCodeCopy();
    installWideTables();
    installSectionFolding();
    installMermaidTools();
    installDiagrams();
    requestAnimationFrame(installSidebarResizers);
  });
</script>
