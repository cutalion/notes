---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

import CopyActions from './CopyActions.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="notes-header">
  <div class="notes-header-start">
    {hasSidebar && (
      <button
        class="notes-panel-toggle"
        type="button"
        data-notes-toggle="tree"
        aria-controls="starlight__sidebar"
        aria-label="Pin the notes tree"
        aria-pressed="true"
        title="Pin or unpin the notes tree"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="16" rx="3"></rect>
          <path d="M9 4v16"></path>
        </svg>
      </button>
    )}
    <SiteTitle />
  </div>
  <div class="notes-header-search print:hidden">
    <Search />
  </div>
  <div class="notes-header-end print:hidden">
    <CopyActions />
    <div class="sl-hidden md:sl-flex">
      <ThemeSelect />
    </div>
    <button
      class="notes-panel-toggle"
      type="button"
      data-notes-toggle="toc"
      aria-label="Pin the page contents"
      aria-pressed="true"
      title="Pin or unpin the page contents"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <rect x="3" y="4" width="18" height="16" rx="3"></rect>
        <path d="M15 4v16"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  // The inline script in `Head.astro` has already put the stored state on the root element.
  const root = document.documentElement;
  const canHover = window.matchMedia('(hover: hover)');
  // A panel waits a moment before it floats in, and twice as long before it leaves. Without
  // the delays it would jump out on every pass of the pointer over its button.
  const showDelay = 120;
  const hideDelay = 280;

  const panels = [
    {
      name: 'tree',
      layer: '#starlight__sidebar',
      unpinned: ['notesTree', 'unpinned'],
      peek: 'notesPeek',
      storageKey: 'notes:mainSideBarCollapsed',
      // Below this width the panel is a drawer of Starlight and has no button here.
      wide: window.matchMedia('(min-width: 50rem)'),
    },
    {
      name: 'toc',
      layer: '.right-sidebar',
      unpinned: ['notesToc', 'hidden'],
      peek: 'notesTocPeek',
      storageKey: 'notes:rightSideBarCollapsed',
      wide: window.matchMedia('(min-width: 72rem)'),
    },
  ] as const;

  for (const panel of panels) {
    const button = document.querySelector<HTMLButtonElement>(`[data-notes-toggle="${panel.name}"]`);
    const layer = document.querySelector<HTMLElement>(panel.layer);
    if (!button) continue;
    const [stateKey, stateValue] = panel.unpinned;
    let timer: number | undefined;

    const pinned = () => root.dataset[stateKey] !== stateValue;
    const reflect = () => button.setAttribute('aria-pressed', String(pinned()));

    const setPeek = (shown: boolean) => {
      window.clearTimeout(timer);
      if (shown) root.dataset[panel.peek] = '';
      else delete root.dataset[panel.peek];
    };

    const schedulePeek = (shown: boolean) => {
      window.clearTimeout(timer);
      if (pinned() || !panel.wide.matches || !canHover.matches) return;
      if (shown === (panel.peek in root.dataset)) return;
      timer = window.setTimeout(() => setPeek(shown), shown ? showDelay : hideDelay);
    };

    button.addEventListener('click', () => {
      setPeek(false);
      if (pinned()) root.dataset[stateKey] = stateValue;
      else delete root.dataset[stateKey];
      localStorage.setItem(panel.storageKey, String(!pinned()));
      reflect();
    });

    for (const element of [button, layer]) {
      element?.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') schedulePeek(true);
      });
      element?.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse') schedulePeek(false);
      });
    }

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel.peek in root.dataset) setPeek(false);
    });

    reflect();
  }
</script>

<style>
  .notes-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--notes-space-2);
    height: 100%;
  }

  .notes-header-start,
  .notes-header-end {
    display: flex;
    align-items: center;
    gap: var(--notes-space-1);
    min-width: 0;
  }

  .notes-header-end {
    justify-content: flex-end;
  }

  .notes-header-search {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .notes-panel-toggle {
    display: none;
    flex: 0 0 var(--notes-control-height);
    align-items: center;
    justify-content: center;
    width: var(--notes-control-height);
    height: var(--notes-control-height);
    padding: 0;
    border: 0;
    border-radius: var(--notes-radius-small);
    background: transparent;
    color: var(--notes-color-body);
    cursor: pointer;
  }

  /* A pinned panel keeps its button pressed, and so does a panel that floats. The pointer
     darkens the button one more step, so the button answers in either state. */
  .notes-panel-toggle:hover {
    background: var(--notes-color-hover);
    color: var(--notes-color-ink);
  }

  .notes-panel-toggle[aria-pressed='true'],
  :global(:root[data-notes-peek]) .notes-panel-toggle[data-notes-toggle='tree'],
  :global(:root[data-notes-toc-peek]) .notes-panel-toggle[data-notes-toggle='toc'] {
    background: var(--notes-color-pressed);
  }

  .notes-panel-toggle[aria-pressed='true']:hover {
    background: var(--notes-color-pressed-hover);
  }

  .notes-panel-toggle svg {
    width: var(--notes-icon-size);
    height: var(--notes-icon-size);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: var(--notes-icon-stroke);
  }

  @media (min-width: 50rem) {
    /* The search stays in the middle of the header, whatever the width of the two sides. */
    .notes-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, var(--notes-search-width)) minmax(0, 1fr);
    }

    .notes-panel-toggle[data-notes-toggle='tree'] {
      display: inline-flex;
    }
  }

  @media (min-width: 72rem) {
    :global(:root[data-has-toc]) .notes-panel-toggle[data-notes-toggle='toc'] {
      display: inline-flex;
    }
  }
</style>
